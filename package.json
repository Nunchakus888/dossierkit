{
  "name": "dossierkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data-driven bilingual expert dossier template with Git-backed CMS and static exports.",
  "scripts": {
    "generate:mcp-skill": "tsx scripts/generate-mcp-skill.ts",
    "dev": "pnpm generate:mcp-skill && tsx scripts/generate-note-covers.ts && astro dev",
    "build": "pnpm generate:mcp-skill && tsx scripts/generate-note-covers.ts && astro build",
    "build:mcp": "pnpm generate:mcp-skill && tsx scripts/build-mcp-static.ts",
    "postbuild": "pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-profile.ts",
    "test:notes": "tsx scripts/test-notes.ts",
    "test:integrations": "node --test scripts/social/*.test.mjs && tsx scripts/test-integrations.ts",
    "test:assets": "pnpm generate:mcp-skill && node --test scripts/note-assets.test.mjs scripts/plugin.test.mjs && tsx scripts/test-note-bundles.ts && tsx scripts/test-mcp-skill.ts",
    "package:plugin": "node scripts/package-notes-plugin.mjs",
    "social:assist": "node scripts/social/assist.mjs",
    "provision:notes-access": "tsx scripts/provision-notes-access.ts",
    "dossier": "tsx scripts/dossier.ts",
    "create-profile": "tsx scripts/create-profile.ts",
    "generate-admin-config": "tsx scripts/generate-cms.ts",
    "generate-pdf": "tsx scripts/generate-pdf.ts",
    "export-profile": "tsx scripts/export-profile.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.1",
    "@astrojs/sitemap": "^3.5.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.9",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "marked": "^16.1.1",
    "mermaid": "^11.16.0",
    "pinyin-pro": "3.28.1",
    "sanitize-html": "2.17.0",
    "tailwindcss": "^4.1.11",
    "yaml": "^2.8.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/sanitize-html": "2.16.0",
    "pagefind": "1.3.0",
    "playwright": "^1.54.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "4.105.0"
  },
  "packageManager": "pnpm@11.7.0"
}
