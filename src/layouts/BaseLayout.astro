---
import ViewCounterClient from "../components/views/ViewCounterClient.astro";
import Header from "../components/layout/Header.astro";
import SiteIcons from "../components/seo/SiteIcons.astro";
import Footer from "../components/layout/Footer.astro";
import CloudflareAnalytics from "../components/integrations/CloudflareAnalytics.astro";
import NoteEngagement from "../components/notes/NoteEngagement.astro";
import ShareMetadata from "../components/seo/ShareMetadata.astro";
import { defaultLocale, type Locale } from "../lib/config";
import { loadProfilePack, findContentBySlug } from "../lib/profile-loader";
import { publicationHash } from "../lib/publication";
import { pageDescription, pageTitle } from "../lib/seo";
import "../styles/global.css";
import "../styles/theme.css";
import "../styles/wordmarks.css";

type Props = {
  locale?: Locale;
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
};
const {
  locale = defaultLocale, title, description, canonicalPath = Astro.url.pathname,
  ogType = "website", publishedTime, modifiedTime
} = Astro.props;
const pack = loadProfilePack();
const theme = pack.theme;
const colors = theme.colors as typeof theme.colors & Record<string, string | undefined>;
const titleText = pageTitle(pack, locale, title);
const descriptionText = pageDescription(pack, locale, description);
const canonicalUrl = new URL(canonicalPath, Astro.site || Astro.url.origin).toString();
const noteMatch = /^\/(zh|en)\/notes\/([a-z0-9]+(?:-[a-z0-9]+)*)\/?$/.exec(canonicalPath);
const note = noteMatch ? findContentBySlug(locale, "notes", noteMatch[2]) : undefined;
const noteRef = note ? `${locale}/${note.slug}` : undefined;
const path = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\/+$/, "") || "/";
const publicPage = /^\/(zh|en)(\/|$)/.test(path || "");
const pageRef = noteRef || `page:${path}`;
// Locale homes show only the site total; every child page shows page / site.
const footerPageRef = publicPage && !/^\/(zh|en)$/.test(path) ? pageRef : undefined;
const cssVars = [
  `--color-background: ${colors.background}`, `--color-surface: ${colors.surface}`,
  `--color-foreground: ${colors.foreground}`, `--color-muted: ${colors.muted}`,
  `--color-border: ${colors.border}`, `--color-accent: ${colors.accent}`,
  `--color-accent-soft: ${colors.accentSoft}`, `--color-warm: ${colors.warm}`,
  `--color-mint: ${colors.mint || colors.accent}`, `--color-blue: ${colors.blue || colors.cyan || colors.accent}`,
  `--color-cyan: ${colors.cyan || colors.accentSoft}`, `--layout-max-width: ${theme.layout.maxWidth}`,
  `--card-radius: ${theme.layout.cardRadius}`
].join("; ");
---
<!doctype html>
<html lang={locale} style={cssVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descriptionText} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={titleText} />
    <meta property="og:description" content={descriptionText} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:title" content={titleText} />
    <meta name="twitter:description" content={descriptionText} />
    <ShareMetadata noteRef={noteRef} locale={locale} />
    {publicPage && <meta name="dossierkit:page-ref" content={pageRef} />}
    {note && <meta name="dossierkit:note-ref" content={noteRef} />}
    {note && <meta name="dossierkit:content-hash" content={publicationHash(note)} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <SiteIcons />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{titleText}</title>
  </head>
  <body>
    <Header locale={locale} pack={pack} />
    <main data-pagefind-body>
      <slot />
      {note && <NoteEngagement noteRef={noteRef} title={note.data.title} summary={note.data.summary} url={canonicalUrl} locale={locale} />}
    </main>
    <Footer locale={locale} pack={pack} pageRef={footerPageRef} />
    <CloudflareAnalytics />
    {publicPage && <ViewCounterClient />}
  </body>
</html>

