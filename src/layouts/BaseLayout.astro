---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { defaultLocale, type Locale } from "../lib/config";
import { loadProfilePack } from "../lib/profile-loader";
import { pageDescription, pageTitle } from "../lib/seo";
import "../styles/global.css";
import "../styles/theme.css";

type Props = {
  locale?: Locale;
  title?: string;
  description?: string;
};

const { locale = defaultLocale, title, description } = Astro.props;
const pack = loadProfilePack();
const theme = pack.theme;
const colors = theme.colors as typeof theme.colors & Record<string, string | undefined>;
const titleText = pageTitle(pack, locale, title);
const descriptionText = pageDescription(pack, locale, description);
const cssVars = [
  `--color-background: ${colors.background}`,
  `--color-surface: ${colors.surface}`,
  `--color-foreground: ${colors.foreground}`,
  `--color-muted: ${colors.muted}`,
  `--color-border: ${colors.border}`,
  `--color-accent: ${colors.accent}`,
  `--color-accent-soft: ${colors.accentSoft}`,
  `--color-warm: ${colors.warm}`,
  `--color-mint: ${colors.mint || colors.accent}`,
  `--color-purple: ${colors.purple || colors.warm}`,
  `--color-cyan: ${colors.cyan || colors.accentSoft}`,
  `--layout-max-width: ${theme.layout.maxWidth}`,
  `--card-radius: ${theme.layout.cardRadius}`
].join("; ");
---

<!doctype html>
<html lang={locale} style={cssVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descriptionText} />
    <meta property="og:title" content={titleText} />
    <meta property="og:description" content={descriptionText} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <title>{titleText}</title>
  </head>
  <body>
    <Header locale={locale} pack={pack} />
    <main data-pagefind-body>
      <slot />
    </main>
    <Footer locale={locale} pack={pack} />
  </body>
</html>
