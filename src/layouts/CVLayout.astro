---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/common/Icon.astro";
import type { Locale } from "../lib/config";
import { labels, localize } from "../lib/i18n";
import type { ProfilePack } from "../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const displayName = localize(pack.profile.name, locale);
const signatureGradientId = `signature-gradient-${locale}`;
const pdfHref = `/resumes/${pack.resume.filename}-${locale}.pdf`;
const downloadLabel = locale === "zh" ? "下载 PDF 简历" : "Download PDF";
const printLabel = locale === "zh" ? "打印 / 另存为 PDF" : "Print / Save PDF";
const experienceLabel = locale === "zh" ? "经历" : "Experience";
const featuredProjectsLabel = locale === "zh" ? "项目经验" : "Selected Projects";
const profileLabel = locale === "zh" ? "概览" : "Profile";
const educationLabel = locale === "zh" ? "教育" : "Education";
const yearsLabel = locale === "zh" ? `${pack.profile.yearsOfExperience} 年经验` : `${pack.profile.yearsOfExperience} years`;
---

<BaseLayout locale={locale} title={l.cv} description={localize(pack.profile.summary, locale)}>
  <article class={`page-shell cv-page cv-${locale}`}>
    <header class="cv-header">
      <div class="identity">
        <h1 aria-label={displayName}>
          <svg class="signature-svg" viewBox="0 0 390 88" role="img" aria-labelledby={`${signatureGradientId}-title`}>
            <title id={`${signatureGradientId}-title`}>{displayName}</title>
            <defs>
              <linearGradient id={signatureGradientId} x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#207f72" />
                <stop offset="34%" stop-color="#2fb98f" />
                <stop offset="66%" stop-color="#55bea2" />
                <stop offset="100%" stop-color="#2b9f98" />
              </linearGradient>
            </defs>
            <text x="0" y="62" fill={`url(#${signatureGradientId})`}>{displayName}</text>
          </svg>
        </h1>
        <h2>{localize(pack.profile.headline, locale)}</h2>
      </div>

      <div class="contact-block">
        <a href={`mailto:${pack.profile.links.email}`}>
          <Icon name="mail" size={15} />
          <span>{pack.profile.links.email}</span>
        </a>
        <span>
          <Icon name="globe" size={15} />
          {localize(pack.profile.location, locale)}
        </span>
        <span>
          <Icon name="briefcase" size={15} />
          {yearsLabel}
        </span>
        <div class="cv-actions no-print">
          <a class="cv-action primary" href={pdfHref} download aria-label={downloadLabel} title={downloadLabel}>
            <Icon name="download" size={18} />
          </a>
          <button class="cv-action" type="button" onclick="window.print()" aria-label={printLabel} title={printLabel}>
            <Icon name="printer" size={18} />
          </button>
        </div>
      </div>
    </header>

    <section class="profile-section">
      <h3>{profileLabel}</h3>
      <p class="profile-summary">{localize(pack.profile.summary, locale)}</p>
      <dl class="impact-grid">
        {pack.metrics.metrics.map((metric) => (
          <div>
            <dt>{localize(metric.label, locale)}</dt>
            <dd>{localize(metric.value, locale)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="experience-section">
      <h3>{experienceLabel}</h3>
      {pack.experience.experiences.map((item) => (
        <article class="cv-item">
          <div class="item-heading">
            <strong>{localize(item.role, locale)}</strong>
            <span>{localize(item.company, locale)}</span>
          </div>
          <time>{localize(item.period, locale)}</time>
          <p>{localize(item.summary, locale)}</p>
          {item.featuredProjects.length > 0 && (
            <div class="featured-projects">
              <span class="featured-projects-label">{featuredProjectsLabel}</span>
              {item.featuredProjects.map((project) => (
                <div class:list={["featured-project", { "has-details": project.details.length > 0 }]}>
                  <strong>{localize(project.title, locale)}</strong>
                  <p>{localize(project.summary, locale)}</p>
                  {project.details.length > 0 && (
                    <dl class="featured-project-details">
                      {project.details.map((detail) => (
                        <div>
                          <dt>{localize(detail.title, locale)}</dt>
                          <dd>{localize(detail.summary, locale)}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </div>
              ))}
            </div>
          )}
          {item.highlights.length > 0 && (
            <ul>
              {item.highlights.map((highlight) => <li>{localize(highlight, locale)}</li>)}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section class="skills-section">
      <h3>{l.skills}</h3>
      <div class="skills-grid">
        {pack.skills.skillGroups.map((group) => (
          <div>
            <strong>{localize(group.title, locale)}</strong>
            <p>{group.skills.join(" / ")}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="education-section">
      <h3>{educationLabel}</h3>
      {pack.education.education.map((item) => (
        <article class="cv-item compact">
          <div class="item-heading">
            <strong>{localize(item.school, locale)}</strong>
            <span>{localize(item.degree, locale)}</span>
          </div>
          <time>{item.period}</time>
        </article>
      ))}
    </section>
  </article>
</BaseLayout>

<style>
  .cv-page {
    margin-top: 34px;
    margin-bottom: 64px;
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 6%);
    border-radius: 8px;
    padding: 46px 50px 56px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 22px 58px rgba(38, 47, 58, 0.08);
  }

  .cv-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: end;
    border-bottom: 2px solid var(--color-foreground);
    padding-bottom: 24px;
  }

  h1 {
    margin: 0;
    line-height: 1;
  }

  .signature-svg {
    display: block;
    width: min(100%, 330px);
    height: auto;
    overflow: visible;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .signature-svg text {
    font-family: "Pacifico", "Brush Script MT", cursive;
    font-size: 56px;
    font-weight: 400;
    letter-spacing: 1px;
  }

  h2 {
    max-width: 760px;
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 1.22rem;
    font-weight: 680;
  }

  .contact-block {
    display: grid;
    gap: 7px;
    justify-items: end;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .contact-block > a,
  .contact-block > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .contact-block > a:hover {
    color: #207f72;
  }

  .cv-actions {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }

  .cv-action {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(246, 255, 252, 0.76)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.36), rgba(79, 169, 216, 0.26)) border-box;
    color: #207f72;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(49, 125, 154, 0.08);
    transition: transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
  }

  .cv-action.primary {
    background: var(--gradient-primary);
    color: #ffffff;
    box-shadow: var(--shadow-glow);
  }

  .cv-action:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 30px rgba(49, 125, 154, 0.13);
  }

  .cv-page > section {
    margin-top: 30px;
  }

  h3 {
    width: fit-content;
    margin: 0 0 13px;
    color: #2a9f82;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .profile-summary {
    max-width: 860px;
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 22%);
    font-size: 1rem;
    line-height: 1.65;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0 0;
  }

  .impact-grid div {
    border-top: 2px solid color-mix(in srgb, var(--color-accent), white 26%);
    padding-top: 10px;
  }

  .impact-grid dt {
    color: var(--color-muted);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .impact-grid dd {
    margin: 5px 0 0;
    color: var(--color-foreground);
    font-size: 0.96rem;
    font-weight: 760;
    line-height: 1.35;
  }

  .cv-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    gap: 7px 20px;
    border-top: 1px solid var(--color-border);
    padding: 17px 0;
  }

  .item-heading strong,
  .item-heading span {
    display: block;
  }

  .item-heading strong {
    font-size: 1rem;
  }

  .item-heading span,
  time {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  time {
    white-space: nowrap;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .cv-item > p,
  .cv-item > ul,
  .featured-projects {
    grid-column: 1 / -1;
  }

  .cv-item > p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 27%);
    line-height: 1.62;
  }

  .featured-projects {
    display: grid;
    gap: 8px;
    border-left: 2px solid color-mix(in srgb, var(--color-accent), white 18%);
    padding: 7px 0 7px 12px;
    background: linear-gradient(90deg, rgba(70, 183, 148, 0.07), transparent 72%);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .featured-projects-label {
    color: #248f79;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .featured-project {
    display: grid;
    gap: 3px;
    break-inside: avoid;
  }

  .featured-project strong {
    color: var(--color-foreground);
    font-size: 0.92rem;
  }

  .featured-project p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 24%);
    line-height: 1.55;
  }

  .featured-project-details {
    display: grid;
    gap: 5px;
    margin: 2px 0 0;
  }

  .featured-project-details div {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 7px;
  }

  .featured-project-details dt {
    color: #248f79;
    font-weight: 800;
  }

  .featured-project-details dd {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 24%);
    line-height: 1.55;
  }

  .cv-item > ul {
    display: grid;
    gap: 5px;
    padding-left: 1.15rem;
    margin: 1px 0 0;
  }

  .cv-item li {
    padding-left: 3px;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 25%);
    line-height: 1.58;
  }

  .cv-item li::marker {
    color: var(--color-accent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 22px;
  }

  .skills-grid div {
    border-top: 1px solid var(--color-border);
    padding-top: 11px;
  }

  .skills-grid strong {
    font-size: 0.95rem;
  }

  .skills-grid p {
    margin: 5px 0 0;
    color: var(--color-muted);
    font-size: 0.89rem;
    line-height: 1.55;
  }

  .cv-item.compact {
    padding-bottom: 0;
  }

  @media (max-width: 760px) {
    .cv-page {
      width: min(100% - 24px, var(--layout-max-width));
      margin-top: 20px;
      padding: 28px 22px 38px;
    }

    .cv-header,
    .cv-item,
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .contact-block {
      justify-items: start;
    }

    time {
      text-align: left;
    }

    .impact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-project-details div {
      grid-template-columns: 1fr;
      gap: 1px;
    }
  }

  @page {
    size: A4;
    margin: 12mm;
  }

  @media print {
    .cv-page {
      width: 100%;
      max-width: none;
      margin: 0;
      border: 0;
      border-radius: 0;
      padding: 0;
      background: #ffffff;
      box-shadow: none;
    }

    .cv-header {
      gap: 20px;
      padding-bottom: 12px;
    }

    .signature-svg {
      width: 236px;
    }

    h2 {
      margin-top: 4px;
      font-size: 10.5pt;
    }

    .contact-block {
      gap: 4px;
      font-size: 8.5pt;
    }

    .cv-page > section {
      margin-top: 14px;
    }

    h3 {
      margin-bottom: 7px;
      font-size: 8.5pt;
    }

    .profile-summary {
      font-size: 9pt;
      line-height: 1.45;
    }

    .impact-grid {
      gap: 8px;
      margin-top: 9px;
    }

    .impact-grid div {
      padding-top: 5px;
    }

    .impact-grid dt {
      font-size: 7pt;
    }

    .impact-grid dd {
      margin-top: 2px;
      font-size: 8.2pt;
    }

    .cv-item {
      gap: 3px 14px;
      break-inside: avoid;
      page-break-inside: avoid;
      padding: 7px 0;
    }

    .experience-section .cv-item:first-of-type {
      break-inside: auto;
      page-break-inside: auto;
    }

    .item-heading strong {
      font-size: 9.2pt;
    }

    .item-heading span,
    time {
      font-size: 8.2pt;
    }

    .cv-item > p,
    .cv-item li,
    .featured-project p,
    .featured-project-details {
      font-size: 8.4pt;
      line-height: 1.4;
    }

    .featured-project-details {
      display: block;
      gap: 2px;
      margin-top: 1px;
    }

    .featured-project-details div {
      gap: 5px;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .featured-project-details div + div {
      margin-top: 2px;
    }

    .featured-project-details dd {
      line-height: 1.4;
    }

    .featured-projects {
      display: block;
      padding: 4px 0 4px 8px;
      background: none;
    }

    .featured-project {
      gap: 1px;
    }

    .featured-project.has-details {
      break-inside: auto;
      page-break-inside: auto;
    }

    .featured-project + .featured-project {
      margin-top: 4px;
    }

    .featured-projects-label {
      display: block;
      margin-bottom: 4px;
      font-size: 7pt;
    }

    .experience-section .cv-item:not(:first-of-type) .featured-projects-label {
      display: none;
    }

    .featured-project strong {
      font-size: 8.5pt;
    }

    .cv-item > ul {
      gap: 2px;
      padding-left: 13px;
      margin-top: 1px;
    }

    .experience-section .cv-item:not(:first-of-type) > p {
      display: none;
    }

    .skills-section {
      break-before: auto;
      margin-top: 8px !important;
    }

    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 14px;
    }

    .skills-grid div {
      padding-top: 5px;
    }

    .skills-grid strong {
      font-size: 8.2pt;
    }

    .skills-grid p {
      margin-top: 2px;
      font-size: 7.4pt;
      line-height: 1.28;
    }

    .cv-en .skills-grid p {
      font-size: 7.3pt;
      line-height: 1.26;
    }

    .education-section {
      break-inside: avoid;
      margin-top: 8px !important;
    }

    .education-section h3 {
      margin-bottom: 3px;
    }

    .education-section .cv-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      break-inside: avoid;
      page-break-inside: avoid;
      padding: 5px 0 0;
    }

    .education-section time {
      display: block;
      margin-top: 2px;
      text-align: left;
    }
  }
</style>
