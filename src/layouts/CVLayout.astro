---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/common/Icon.astro";
import type { Locale } from "../lib/config";
import { labels, localize } from "../lib/i18n";
import type { ProfilePack } from "../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const pdfHref = `/resumes/${pack.resume.filename}-${locale}.pdf`;
const downloadLabel = locale === "zh" ? "下载 PDF 简历" : "Download PDF";
const printLabel = locale === "zh" ? "打印 / 另存为 PDF" : "Print / Save PDF";
---

<BaseLayout locale={locale} title={l.cv} description={localize(pack.profile.summary, locale)}>
  <section class="page-shell cv-page">
    <header class="cv-header">
      <div>
        <h1>{localize(pack.profile.name, locale)}</h1>
        <h2>{localize(pack.profile.headline, locale)}</h2>
      </div>
      <div class="contact">
        <span>{pack.profile.links.email}</span>
        <span>{localize(pack.profile.location, locale)}</span>
        <span>{pack.profile.yearsOfExperience} years</span>
        <div class="cv-actions no-print">
          <a class="cv-action primary" href={pdfHref} download aria-label={downloadLabel} title={downloadLabel}>
            <Icon name="download" size={18} />
          </a>
          <button class="cv-action" type="button" onclick="window.print()" aria-label={printLabel} title={printLabel}>
            <Icon name="printer" size={18} />
          </button>
        </div>
      </div>
    </header>

    <section>
      <h3>{locale === "zh" ? "概述" : "Summary"}</h3>
      <p>{localize(pack.profile.summary, locale)}</p>
      <ul>
        {pack.resume.highlights.map((highlight) => <li>{localize(highlight, locale)}</li>)}
      </ul>
    </section>

    <section>
      <h3>{l.experience}</h3>
      {pack.experience.experiences.map((item) => (
        <article class="cv-item">
          <div>
            <strong>{localize(item.role, locale)}</strong>
            <span>{item.company}</span>
          </div>
          <time>{localize(item.period, locale)}</time>
          <p>{localize(item.summary, locale)}</p>
          <ul>
            {item.highlights.map((highlight) => <li>{localize(highlight, locale)}</li>)}
          </ul>
        </article>
      ))}
    </section>

    <section>
      <h3>{l.skills}</h3>
      <div class="skills-grid">
        {pack.skills.skillGroups.map((group) => (
          <div>
            <strong>{localize(group.title, locale)}</strong>
            <p>{group.skills.join(" / ")}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h3>{locale === "zh" ? "教育" : "Education"}</h3>
      {pack.education.education.map((item) => (
        <article class="cv-item compact">
          <div>
            <strong>{item.school}</strong>
            <span>{localize(item.degree, locale)}</span>
          </div>
          <time>{item.period}</time>
        </article>
      ))}
    </section>
  </section>
</BaseLayout>

<style>
  .cv-page {
    padding: 42px 0 70px;
  }

  .cv-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    border-bottom: 2px solid var(--color-foreground);
    padding-bottom: 24px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    line-height: 1;
  }

  h2 {
    max-width: 760px;
    margin: 12px 0 0;
    color: var(--color-muted);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .contact {
    display: grid;
    gap: 6px;
    align-self: end;
    color: var(--color-muted);
    text-align: right;
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 14px;
  }

  .cv-action {
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-blue), white 36%);
    border-radius: 999px;
    padding: 0;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-blue);
    font: inherit;
    font-weight: 780;
    line-height: 1.1;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(49, 125, 154, 0.08);
    transition:
      transform 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out),
      border-color 180ms var(--ease-out);
  }

  .cv-action.primary {
    border-color: color-mix(in srgb, var(--color-mint), #2f3140 10%);
    background: var(--color-mint);
    color: #ffffff;
    box-shadow: 0 14px 28px rgba(85, 190, 162, 0.2);
  }

  .cv-action:hover {
    transform: translateY(-1px);
    border-color: var(--color-blue);
    box-shadow: 0 16px 30px rgba(49, 125, 154, 0.13);
  }

  section {
    margin-top: 32px;
  }

  h3 {
    margin: 0 0 14px;
    color: var(--color-accent);
    font-size: 1rem;
    text-transform: uppercase;
  }

  p,
  li {
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 30%);
  }

  .cv-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 140px;
    gap: 8px 18px;
    border-top: 1px solid var(--color-border);
    padding: 16px 0;
  }

  .cv-item strong,
  .cv-item span {
    display: block;
  }

  .cv-item span,
  time {
    color: var(--color-muted);
  }

  .cv-item p,
  .cv-item ul {
    grid-column: 1 / -1;
    margin: 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .skills-grid div {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }

  @media (max-width: 720px) {
    .cv-header,
    .cv-item,
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .contact {
      text-align: left;
    }

    .cv-actions {
      justify-content: flex-start;
    }
  }

  @media print {
    .cv-actions {
      display: none;
    }

    .cv-page {
      width: 100%;
      padding: 0;
    }

    section {
      break-inside: avoid;
      margin-top: 22px;
    }

    h1 {
      font-size: 34px;
    }
  }
</style>
