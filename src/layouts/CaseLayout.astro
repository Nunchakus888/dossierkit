---
import BaseLayout from "./BaseLayout.astro";
import type { Locale } from "../lib/config";
import { labels, localePath } from "../lib/i18n";
import type { ContentEntry } from "../lib/profile-loader";

type Props = {
  locale: Locale;
  entry: ContentEntry;
};

const { locale, entry } = Astro.props;
const l = labels[locale];
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.summary}>
  <article class="page-shell article-page">
    <a class="back-link no-print" href={localePath(locale, "work")}>{l.backToList}</a>
    <header>
      <p>{entry.data.period || "Case Study"}</p>
      <h1>{entry.data.title}</h1>
      <div class="summary">{entry.data.summary}</div>
      <ul class="tag-list">
        {entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </header>
    <div class="prose" set:html={entry.html} />
  </article>
</BaseLayout>

<style>
  .article-page {
    padding: 46px 0 72px;
  }

  .back-link {
    color: var(--color-accent);
    font-weight: 750;
  }

  header {
    max-width: 820px;
    margin: 18px 0 42px;
  }

  header p {
    margin: 0 0 10px;
    color: var(--color-accent);
    font-weight: 750;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4.5vw, 4.3rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .summary {
    margin-top: 18px;
    color: var(--color-muted);
    font-size: 1.15rem;
  }

  .tag-list {
    margin-top: 20px;
  }
</style>
