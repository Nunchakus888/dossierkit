---
import IconAction from '../common/IconAction.astro';
import Icon from '../common/Icon.astro';
const { locale = 'zh' } = Astro.props;
---
<template data-reader-prompt-template>
  <IconAction icon="copy" label={locale === 'zh' ? '复制提示词' : 'Copy prompt'} data-copy-reader-prompt />
</template>
<template data-reader-prompt-success><Icon name="check" /></template>

<script>
  // Enhance only explicitly marked reader prompts. Mermaid and other code stay untouched.
  function initializeReaderPrompts() {
    const template = document.querySelector('[data-reader-prompt-template]');
    const success = document.querySelector('[data-reader-prompt-success]');
    if (!(template instanceof HTMLTemplateElement) || !(success instanceof HTMLTemplateElement)) return;
    const zh = document.documentElement.lang.startsWith('zh');
    const label = zh ? '复制提示词' : 'Copy prompt';
    const copied = zh ? '已复制' : 'Copied';
    const manual = zh ? '已选中提示词，请手动复制' : 'Prompt selected; copy it manually';

    for (const code of document.querySelectorAll('.note-prose pre > code.language-prompt')) {
      const pre = code.parentElement;
      if (!(pre instanceof HTMLPreElement) || pre.dataset.promptCopyReady) continue;
      const button = template.content.querySelector('button')?.cloneNode(true);
      if (!(button instanceof HTMLButtonElement)) continue;
      pre.dataset.promptCopyReady = 'true';
      const wrapper = document.createElement('div');
      wrapper.className = 'reader-prompt';
      const toolbar = document.createElement('div');
      toolbar.className = 'reader-prompt-toolbar no-print';
      toolbar.setAttribute('data-pagefind-ignore', '');
      const status = document.createElement('span');
      status.className = 'visually-hidden';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      toolbar.append(button, status);
      pre.before(wrapper);
      wrapper.append(toolbar, pre);
      const idle = Array.from(button.childNodes, node => node.cloneNode(true));
      let busy = false;
      let resetTimer = 0;
      button.addEventListener('click', async () => {
        if (busy) return;
        busy = true;
        window.clearTimeout(resetTimer);
        status.textContent = '';
        button.setAttribute('aria-busy', 'true');
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
          // Read only the prompt body, never the toolbar label or surrounding article.
          await navigator.clipboard.writeText(code.textContent || '');
          button.replaceChildren(success.content.cloneNode(true));
          button.title = copied;
          button.setAttribute('aria-label', copied);
          status.textContent = copied;
        } catch {
          const selection = window.getSelection();
          if (selection) {
            const range = document.createRange();
            range.selectNodeContents(code);
            selection.removeAllRanges();
            selection.addRange(range);
          }
          button.replaceChildren(...idle.map(node => node.cloneNode(true)));
          button.title = manual;
          button.setAttribute('aria-label', manual);
          status.textContent = manual;
        } finally {
          busy = false;
          button.removeAttribute('aria-busy');
          resetTimer = window.setTimeout(() => {
            button.replaceChildren(...idle.map(node => node.cloneNode(true)));
            button.title = label;
            button.setAttribute('aria-label', label);
          }, 2400);
        }
      });
    }
  }
  initializeReaderPrompts();
  document.addEventListener('astro:page-load', initializeReaderPrompts);
</script>

<style>
  :global(.reader-prompt) {
    min-width: 0;
    margin: 1.25rem 0;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    overflow: hidden;
  }
  :global(.reader-prompt-toolbar) {
    display: flex;
    justify-content: flex-end;
    padding: 2px 4px;
  }
  :global(.reader-prompt > pre) {
    margin: 0;
    padding: 0.25rem 1rem 1rem;
    max-height: 26rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    overflow: auto;
  }
  :global(.reader-prompt > pre > code.language-prompt) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
    line-height: 1.75;
  }
  @media print {
    :global(.reader-prompt), :global(.reader-prompt > pre) {
      max-height: none;
      overflow: visible;
    }
  }
</style>
