---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { labels, localePath } from "../../lib/i18n";
import type { ContentEntry } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  entry: ContentEntry;
};

const { locale, entry } = Astro.props;
const l = labels[locale];
---

<article class="writing-row">
  <div>
    <span>{entry.data.date || "Writing"}</span>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
  </div>
  <a href={localePath(locale, `writing/${entry.slug}`)} aria-label={l.readMore} title={l.readMore}>
    <Icon name="arrow-right" size={16} />
  </a>
</article>

<style>
  .writing-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    border-top: 1px solid var(--color-border);
    padding: 18px 0;
  }

  span {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 750;
  }

  h3 {
    margin: 6px 0;
    font-size: 1.25rem;
    line-height: 1.18;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  a {
    display: inline-grid;
    width: 34px;
    height: 34px;
    place-items: center;
    align-self: center;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-accent);
    transition: transform 180ms var(--ease-out), border-color 180ms var(--ease-out);
  }

  a:hover {
    transform: translateX(2px);
    border-color: color-mix(in srgb, var(--color-accent), transparent 30%);
  }

  @media (max-width: 640px) {
    .writing-row {
      grid-template-columns: 1fr;
    }
  }
</style>
