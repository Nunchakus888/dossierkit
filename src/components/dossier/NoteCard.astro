---
import ViewCount from "../views/ViewCount.astro";
import type { Locale } from "../../lib/config";
import { localePath } from "../../lib/i18n";
import type { ContentEntry } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  entry: ContentEntry;
};

const { locale, entry } = Astro.props;
const topics = entry.data.topics.length > 0 ? entry.data.topics : entry.data.tags;
const kindLabel = {
  research: locale === "zh" ? "研究" : "Research",
  learning: locale === "zh" ? "学习" : "Learning",
  engineering: locale === "zh" ? "工程" : "Engineering"
}[entry.data.kind || "research"];
const timestamp = entry.data.updatedAt || entry.data.lastReviewedAt || entry.data.date;
const timestampLabel = timestamp ? formatTimestamp(timestamp) : "";

function formatTimestamp(value: string) {
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  }).formatToParts(date);
  const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((item) => item.type === type)?.value || "";
  return `${part("year")}-${part("month")}-${part("day")} ${part("hour")}:${part("minute")}:${part("second")}`;
}
---

<article class="note-card card" data-note-card data-search={`${entry.data.title} ${entry.data.summary} ${topics.join(" ")}`.toLowerCase()}>
  <div class="note-card-content">
    <div class="note-meta">
      <span>{kindLabel}</span>
      {timestamp && <time datetime={timestamp}>{timestampLabel}</time>}
      <ViewCount noteRef={`${locale}/${entry.slug}`} locale={locale} />
    </div>
    <h2><a href={localePath(locale, `notes/${entry.slug}`)}>{entry.data.title}</a></h2>
    <p>{entry.data.summary}</p>
    {topics.length > 0 && (
      <ul class="tag-list" aria-label={locale === "zh" ? "主题" : "Topics"}>
        {topics.slice(0, 6).map((topic) => <li class="tag">{topic}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .note-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 26px;
  }

  .note-card-content {
    position: relative;
    z-index: 1;
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .note-meta span + time::before {
    margin-right: 10px;
    color: var(--color-border);
    content: "•";
  }

  h2 {
    margin: 9px 0 8px;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.2;
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  h2 a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 3px;
  }

  p {
    max-width: 760px;
    margin: 0 0 16px;
    color: var(--color-muted);
  }


  @media (max-width: 640px) {
    .note-card {
      grid-template-columns: 1fr;
      padding: 20px;
    }

  }
</style>
