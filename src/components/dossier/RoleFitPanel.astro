---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { labels, localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
---

<section class="section-band">
  <div class="page-shell">
    <div class="section-heading">
      <div>
        <h2>{l.roles}</h2>
        <p>{locale === "zh" ? "每个角色页都来自 roles.yaml，可按目标岗位重组案例、实验和能力证明。" : "Each role page is generated from roles.yaml and reassembles work, lab notes, and proof for a target role."}</p>
      </div>
    </div>
    <div class="role-grid">
      {pack.roles.roles.map((role) => (
        <a class="card role-card" href={localePath(locale, `for/${role.path}`)}>
          <div class="role-top">
            <span>{role.focusAreas.slice(0, 2).join(" / ")}</span>
            <Icon name="arrow-right" size={15} />
          </div>
          <div>
            <strong>{localize(role.title, locale)}</strong>
            <p>{localize(role.summary, locale)}</p>
          </div>
          <ul class="tag-list">
            {role.focusAreas.slice(0, 5).map((area) => <li class="tag">{area}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .role-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .role-card {
    display: grid;
    min-height: 250px;
    align-content: space-between;
    gap: 20px;
    padding: 18px;
  }

  .role-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--color-accent);
  }

  .role-top span {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 750;
  }

  strong {
    display: block;
    font-size: 1.28rem;
    font-weight: 740;
    line-height: 1.15;
  }

  p {
    margin: 10px 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .role-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
