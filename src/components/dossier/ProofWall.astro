---
import type { Locale } from "../../lib/config";
import { labels, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
---

<section class="section-band proof">
  <div class="page-shell proof-inner">
    <div>
      <h2>{l.proof}</h2>
      <p>{locale === "zh" ? "围绕平台架构、业务规模、团队治理和交付结果展开。" : "Focused on platform architecture, service scale, team governance, and delivery outcomes."}</p>
    </div>
    <div class="proof-list">
      {pack.resume.highlights.map((highlight) => (
        <p>{localize(highlight, locale)}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .proof {
    background: color-mix(in srgb, var(--color-accent-soft), transparent 58%);
  }

  .proof-inner {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: 36px;
    align-items: start;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2vw, 2rem);
  }

  p {
    color: var(--color-muted);
  }

  .proof-list {
    display: grid;
    gap: 12px;
  }

  .proof-list p {
    margin: 0;
    border-left: 3px solid var(--color-accent);
    padding: 4px 0 4px 16px;
    color: var(--color-foreground);
  }

  @media (max-width: 760px) {
    .proof-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
