---
import type { Locale } from "../../lib/config";
import { labels, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
---

<section class="section-band">
  <div class="page-shell contact-panel">
    <div>
      <p class="eyebrow">{l.contact}</p>
      <h2>{localize(pack.profile.availability.status, locale)}</h2>
      <p>{locale === "zh" ? "适合讨论 Agent 平台、LLM 应用架构、后训练数据闭环和 AI 产品落地。" : "Best for conversations around Agent platforms, LLM application architecture, post-training data loops, and AI product delivery."}</p>
    </div>
    <div class="contact-actions">
      <a class="button primary" href={`mailto:${pack.profile.links.email}`}>{pack.profile.links.email}</a>
      {pack.profile.links.github && <a class="button" href={pack.profile.links.github}>GitHub</a>}
      {pack.profile.links.linkedin && <a class="button" href={pack.profile.links.linkedin}>LinkedIn</a>}
    </div>
  </div>
</section>

<style>
  .contact-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 3rem);
    line-height: 1.08;
  }

  p {
    max-width: 680px;
    color: var(--color-muted);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 760px) {
    .contact-panel {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
