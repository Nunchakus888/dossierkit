---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { labels, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
---

<section class="section-band">
  <div class="page-shell contact-panel">
    <div>
      <p class="eyebrow">{l.contact}</p>
      <h2>{localize(pack.profile.availability.status, locale)}</h2>
      <p>{locale === "zh" ? "适合讨论企业级 Agent 平台架构、运行时治理、评测发布门禁和核心业务流程集成。" : "Best for conversations around enterprise Agent platform architecture, runtime governance, evaluation gates, and core workflow integration."}</p>
    </div>
    <div class="contact-actions">
      <a class="button primary" href={`mailto:${pack.profile.links.email}`}>
        <Icon name="mail" size={16} />
        {pack.profile.links.email}
      </a>
      {pack.profile.links.github && <a class="button" href={pack.profile.links.github}>GitHub</a>}
      {pack.profile.links.linkedin && <a class="button" href={pack.profile.links.linkedin}>LinkedIn</a>}
    </div>
  </div>
</section>

<style>
  .contact-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    border-image: var(--gradient-border) 1;
    padding-top: 34px;
    padding-bottom: 34px;
  }

  .eyebrow {
    margin: 0 0 8px;
    width: fit-content;
    background: var(--gradient-primary);
    background-clip: text;
    color: #207f72;
    font-size: 0.82rem;
    font-weight: 750;
    text-transform: uppercase;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 3rem);
    line-height: 1.08;
  }

  p {
    max-width: 680px;
    color: var(--color-muted);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 760px) {
    .contact-panel {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
