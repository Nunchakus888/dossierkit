---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { labels, localePath } from "../../lib/i18n";
import type { ContentEntry } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  entry: ContentEntry;
};

const { locale, entry } = Astro.props;
const l = labels[locale];
const method = typeof entry.data.method === "string" ? entry.data.method : "Lab";
---

<article class="card lab-card">
  <span>{method}</span>
  <h3>{entry.data.title}</h3>
  <p>{entry.data.summary}</p>
  <ul class="tag-list">
    {entry.data.tags.slice(0, 5).map((tag) => <li class="tag">{tag}</li>)}
  </ul>
  <a class="read-link" href={localePath(locale, `lab/${entry.slug}`)}>
    <span>{l.readMore}</span>
    <Icon name="arrow-right" size={14} />
  </a>
</article>

<style>
  .lab-card {
    display: grid;
    min-height: 240px;
    align-content: space-between;
    gap: 15px;
    padding: 18px;
  }

  span {
    color: var(--color-warm);
    font-size: 0.82rem;
    font-weight: 750;
  }

  h3 {
    margin: 12px 0 10px;
    font-size: 1.3rem;
    line-height: 1.18;
  }

  p {
    color: var(--color-muted);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    color: var(--color-accent);
    font-size: 0.92rem;
    font-weight: 760;
    transition: transform 180ms var(--ease-out);
  }

  .read-link:hover {
    transform: translateX(2px);
  }
</style>
