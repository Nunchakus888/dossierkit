---
import type { Locale } from "../../lib/config";
import { labels, localePath } from "../../lib/i18n";
import type { ContentEntry } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  entry: ContentEntry;
};

const { locale, entry } = Astro.props;
const l = labels[locale];
---

<article class="card content-card">
  <div>
    <span>{entry.data.period || entry.data.date || "Case"}</span>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
  </div>
  <ul class="tag-list">
    {entry.data.tags.slice(0, 5).map((tag) => <li class="tag">{tag}</li>)}
  </ul>
  <a href={localePath(locale, `work/${entry.slug}`)}>{l.readMore}</a>
</article>

<style>
  .content-card {
    display: grid;
    min-height: 260px;
    grid-template-rows: 1fr auto auto;
    gap: 18px;
    padding: 20px;
  }

  span {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 750;
  }

  h3 {
    margin: 12px 0 10px;
    font-size: 1.35rem;
    line-height: 1.18;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  a {
    width: fit-content;
    color: var(--color-accent);
    font-weight: 750;
  }
</style>
