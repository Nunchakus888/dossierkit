---
import type { Locale } from "../../lib/config";
import { labels, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const skillGroups = pack.skills.skillGroups.slice(0, 4);
---

<section class="section-band">
  <div class="page-shell">
    <div class="section-heading">
      <div>
        <h2>{l.metrics}</h2>
        <p>{locale === "zh" ? "用结构化证据快速判断经验、方法和交付范围。" : "Structured proof for evaluating experience, method, and delivery scope."}</p>
      </div>
    </div>
    <div class="bento">
      {pack.metrics.metrics.map((metric) => (
        <article class="card metric-card">
          <span>{localize(metric.label, locale)}</span>
          <strong>{localize(metric.value, locale)}</strong>
          <p>{localize(metric.description, locale)}</p>
        </article>
      ))}
      {skillGroups.map((group) => (
        <article class="card skill-card">
          <span>{l.skills}</span>
          <strong>{localize(group.title, locale)}</strong>
          <p>{localize(group.description, locale)}</p>
          <ul class="tag-list">
            {group.skills.slice(0, 5).map((skill) => <li class="tag">{skill}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  article {
    min-height: 205px;
    padding: 20px;
  }

  .metric-card:first-child {
    grid-column: span 2;
  }

  span {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  strong {
    display: block;
    margin-top: 18px;
    font-size: clamp(1.35rem, 2.2vw, 2.1rem);
    line-height: 1.05;
  }

  p {
    margin: 12px 0 0;
    color: var(--color-muted);
  }

  .tag-list {
    margin-top: 18px;
  }

  @media (max-width: 980px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .metric-card:first-child {
      grid-column: auto;
    }
  }
</style>
