---
import type { Locale } from "../../lib/config";
import { labels, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const skillGroups = pack.skills.skillGroups.slice(0, 4);
---

<section class="section-band">
  <div class="page-shell">
    <div class="section-heading">
      <div>
        <h2>{l.metrics}</h2>
        <p>{locale === "zh" ? "用可扫描的信息密度呈现经验、方法和系统边界。" : "Dense, scannable proof of experience, method, and system boundaries."}</p>
      </div>
    </div>
    <div class="bento">
      {pack.metrics.metrics.map((metric, index) => (
        <article class:list={["card", "metric-card", { wide: index === 0 }]}>
          <span class="index">0{index + 1}</span>
          <div>
            <p class="metric-label">{localize(metric.label, locale)}</p>
            <strong>{localize(metric.value, locale)}</strong>
          </div>
          <p>{localize(metric.description, locale)}</p>
        </article>
      ))}
      {skillGroups.map((group, index) => (
        <article class="card skill-card">
          <span class="index">S{index + 1}</span>
          <strong>{localize(group.title, locale)}</strong>
          <p>{localize(group.description, locale)}</p>
          <ul class="tag-list">
            {group.skills.slice(0, 5).map((skill) => <li class="tag">{skill}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  article {
    display: grid;
    min-height: 214px;
    align-content: space-between;
    gap: 18px;
    padding: 18px;
  }

  .wide {
    grid-column: span 2;
  }

  .index {
    width: fit-content;
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 12%);
    border-radius: 999px;
    padding: 3px 8px;
    color: var(--color-accent);
    font-family: "JetBrains Mono", "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 720;
    line-height: 1.2;
  }

  .metric-label {
    margin: 0 0 8px;
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  strong {
    display: block;
    font-size: clamp(1.22rem, 2vw, 1.85rem);
    font-weight: 740;
    line-height: 1.08;
    letter-spacing: 0;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .tag-list {
    margin-top: 2px;
  }

  @media (max-width: 980px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .wide {
      grid-column: auto;
    }
  }
</style>
