---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const links = pack.design.quickLinks;
const contact = pack.design.contactStrip;
const email = pack.profile.links.email;

function navHref(path: string) {
  if (/^https?:\/\//.test(path)) return path;
  return localePath(locale, path);
}
---

<section class="quick-links">
  <div class="page-shell">
    <div class="quick-grid">
      {links.map((link) => (
        <a class:list={["quick-card", link.tone]} href={navHref(link.path)}>
          <span class="icon-bubble" aria-hidden="true">
            <Icon name={link.icon} size={42} strokeWidth={1.65} />
          </span>
          <span class="quick-copy">
            <strong>{localize(link.label, locale)}</strong>
            <span>{localize(link.description, locale)}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="contact-strip">
      <span class="contact-icon" aria-hidden="true">
        <Icon name="mail" size={30} strokeWidth={1.8} />
      </span>
      <strong>{localize(contact.label, locale)}</strong>
      <a class="contact-email" href={`mailto:${email}`}>{email}</a>
      <a class="contact-action" href={navHref("contact")}>
        <Icon name={contact.icon} size={24} strokeWidth={1.9} />
        <span>{localize(contact.actionLabel, locale)}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .quick-links {
    padding: 28px 0 64px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.52), rgba(255, 255, 255, 0));
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .quick-card {
    display: grid;
    grid-template-columns: 126px minmax(0, 1fr);
    min-height: 150px;
    align-items: center;
    gap: 18px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--tone), white 54%);
    border-radius: 24px;
    padding: 26px;
    background:
      radial-gradient(circle at 18% 10%, rgba(255, 255, 255, 0.9), transparent 36%),
      color-mix(in srgb, var(--tone), white 84%);
    box-shadow: 0 14px 34px rgba(38, 47, 58, 0.055);
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  .quick-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--tone), white 22%);
    box-shadow: 0 20px 46px color-mix(in srgb, var(--tone), transparent 78%);
  }

  .quick-card.mint {
    --tone: var(--color-mint);
  }

  .quick-card.purple {
    --tone: var(--color-purple);
  }

  .quick-card.cyan {
    --tone: var(--color-cyan);
  }

  .icon-bubble {
    display: grid;
    width: 96px;
    height: 96px;
    place-items: center;
    border: 1px solid rgba(219, 229, 232, 0.92);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.74);
    color: var(--tone);
    box-shadow: 0 10px 26px rgba(52, 63, 76, 0.055);
  }

  .quick-copy {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .quick-copy strong {
    color: var(--color-foreground);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 850;
    line-height: 1.12;
  }

  .quick-copy span {
    color: #586577;
    font-size: clamp(0.98rem, 1.45vw, 1.13rem);
    line-height: 1.62;
  }

  .contact-strip {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    min-height: 112px;
    margin-top: 28px;
    border: 1px solid color-mix(in srgb, var(--color-mint), white 68%);
    border-radius: 24px;
    padding: 24px 36px;
    background: rgba(255, 255, 255, 0.66);
    box-shadow: 0 14px 34px rgba(38, 47, 58, 0.045);
    backdrop-filter: blur(12px);
  }

  .contact-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 999px;
    background: var(--color-mint);
    color: white;
    box-shadow: 0 14px 28px rgba(85, 190, 162, 0.24);
  }

  .contact-strip strong {
    color: var(--color-foreground);
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    font-weight: 880;
  }

  .contact-email {
    width: fit-content;
    color: #586577;
    font-size: clamp(1rem, 1.35vw, 1.12rem);
    font-weight: 650;
  }

  .contact-email:hover {
    color: var(--color-mint);
  }

  .contact-action {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-radius: 18px;
    padding: 14px 24px;
    background: var(--color-mint);
    color: white;
    font-size: 1.04rem;
    font-weight: 830;
    box-shadow: 0 14px 28px rgba(85, 190, 162, 0.24);
    transition:
      transform 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }

  .contact-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 36px rgba(85, 190, 162, 0.3);
  }

  @media (max-width: 1040px) {
    .quick-card {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 820px) {
    .quick-links {
      padding-top: 14px;
    }

    .quick-grid {
      grid-template-columns: 1fr;
    }

    .quick-card {
      grid-template-columns: auto minmax(0, 1fr);
      min-height: 126px;
      padding: 20px;
    }

    .icon-bubble {
      width: 78px;
      height: 78px;
    }

    .contact-strip {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 14px 16px;
      padding: 20px;
    }

    .contact-email,
    .contact-action {
      grid-column: 1 / -1;
    }

    .contact-action {
      width: 100%;
    }
  }

  @media (max-width: 460px) {
    .quick-card {
      grid-template-columns: 1fr;
    }
  }
</style>
