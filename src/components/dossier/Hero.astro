---
import Icon from "../common/Icon.astro";
import PlayfulIllustration from "./PlayfulIllustration.astro";
import type { Locale } from "../../lib/config";
import { localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const design = pack.design;
const titleLines = design.hero.title[locale];

function navHref(path: string) {
  if (/^https?:\/\//.test(path)) return path;
  return localePath(locale, path);
}
---

<section class="hero page-shell">
  <div class="hero-copy">
    <p class="eyebrow">{localize(design.hero.eyebrow, locale)}</p>
    <h1>
      {titleLines.map((line) => (
        <span class="title-line">
          {line.segments.map((segment) => <span class:list={["tone", segment.tone]}>{segment.text}</span>)}
        </span>
      ))}
    </h1>
    <p class="summary">{localize(design.hero.subtitle, locale)}</p>
    <div class="button-row">
      <a class="button primary playful-button" href={navHref(design.hero.primaryAction.path)}>
        <Icon name={design.hero.primaryAction.icon || "sparkle"} size={18} />
        {localize(design.hero.primaryAction.label, locale)}
      </a>
      <a class="button playful-button secondary" href={navHref(design.hero.secondaryAction.path)}>
        <Icon name={design.hero.secondaryAction.icon || "user"} size={18} />
        {localize(design.hero.secondaryAction.label, locale)}
      </a>
    </div>
  </div>

  <div class="hero-art">
    <PlayfulIllustration />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: 58px 0 42px;
  }

  .hero::before {
    position: absolute;
    inset: 20px -32px auto;
    z-index: -1;
    height: min(62%, 440px);
    pointer-events: none;
    content: "";
    background:
      linear-gradient(118deg, rgba(234, 249, 244, 0.74), rgba(255, 255, 255, 0.26) 45%, rgba(231, 249, 255, 0.62)),
      repeating-linear-gradient(90deg, rgba(85, 190, 162, 0.1) 0 1px, transparent 1px 72px);
    mask-image: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.76) 14%, rgba(0, 0, 0, 0.58) 76%, transparent);
  }

  .eyebrow {
    margin: 0 0 18px;
    width: fit-content;
    background: var(--gradient-primary);
    background-clip: text;
    color: #207f72;
    font-size: clamp(0.95rem, 1.2vw, 1.14rem);
    font-weight: 700;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-copy {
    min-width: 0;
  }

  h1 {
    display: grid;
    gap: 8px;
    margin: 0;
    font-size: clamp(3.25rem, 6.2vw, 6.15rem);
    font-weight: 820;
    line-height: 0.94;
    letter-spacing: 0;
    max-width: 100%;
  }

  .title-line {
    display: block;
    white-space: nowrap;
  }

  .tone.mint {
    background: linear-gradient(100deg, #207f72, #2fb98f 58%, #55bea2);
    background-clip: text;
    color: var(--color-mint);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tone.blue {
    background: linear-gradient(100deg, #2fb98f, #4fa9d8);
    background-clip: text;
    color: var(--color-blue);
    text-shadow: 0 10px 22px rgba(79, 169, 216, 0.12);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tone.cyan {
    background: linear-gradient(100deg, #55bea2, #78cde1);
    background-clip: text;
    color: var(--color-cyan);
    text-shadow: 0 10px 22px rgba(120, 205, 225, 0.12);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tone.ink {
    color: var(--color-foreground);
  }

  .tone.muted {
    color: var(--color-muted);
  }

  .summary {
    max-width: 520px;
    margin: 28px 0 28px;
    color: #596475;
    font-size: clamp(1.08rem, 1.55vw, 1.35rem);
    line-height: 1.65;
  }

  .playful-button {
    min-height: 56px;
    border-radius: 999px;
    padding: 14px 22px;
    font-size: 1.02rem;
    font-weight: 800;
  }

  .playful-button.primary {
    border-color: transparent;
    background: var(--gradient-primary);
    color: white;
    box-shadow: var(--shadow-glow);
  }

  .playful-button.secondary {
    border-color: transparent;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(246, 255, 252, 0.66)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.34), rgba(79, 169, 216, 0.34)) border-box;
    color: #207f72;
  }

  .hero-art {
    min-width: 0;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 44px;
    }

    .hero-art {
      order: -1;
      max-width: 560px;
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 3rem;
      line-height: 1;
    }

    .title-line {
      white-space: normal;
    }

    .tone {
      display: inline-block;
    }

    .button-row {
      display: grid;
    }
  }
</style>
