---
import type { Locale } from "../../lib/config";
import { labels, localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const avatarSrc = `/profile-assets/${pack.profile.id}/${pack.profile.avatar}`;
---

<section class="hero page-shell">
  <div class="hero-copy">
    <p class="eyebrow">DossierKit / {localize(pack.profile.location, locale)}</p>
    <h1>{localize(pack.profile.headline, locale)}</h1>
    <p class="summary">{localize(pack.profile.summary, locale)}</p>
    <div class="button-row">
      <a class="button primary" href={localePath(locale, "cv")}>{l.viewCv}</a>
      <a class="button" href={localePath(locale, "contact")}>{l.email}</a>
    </div>
  </div>
  <figure class="portrait-wrap">
    <img src={avatarSrc} alt={localize(pack.profile.name, locale)} width="420" height="420" loading="eager" />
    <figcaption>
      <strong>{localize(pack.profile.name, locale)}</strong>
      <span>{localize(pack.profile.availability.status, locale)}</span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(260px, 0.72fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
    padding: 64px 0 46px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.3rem, 5.8vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .summary {
    max-width: 700px;
    margin: 22px 0 26px;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 35%);
    font-size: clamp(1.05rem, 1.45vw, 1.22rem);
  }

  .portrait-wrap {
    margin: 0;
  }

  img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    object-fit: cover;
    box-shadow: 0 24px 70px rgba(24, 32, 27, 0.14);
  }

  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 12px;
  }

  figcaption span {
    color: var(--color-muted);
    font-size: 0.93rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 38px;
    }

    .portrait-wrap {
      max-width: 360px;
    }
  }
</style>
