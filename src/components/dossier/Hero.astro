---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { labels, localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const avatarSrc = `/profile-assets/${pack.profile.id}/${pack.profile.avatar}`;
const proof = [
  {
    label: locale === "zh" ? "经验" : "Experience",
    value: `${pack.profile.yearsOfExperience}+`
  },
  {
    label: locale === "zh" ? "案例" : "Cases",
    value: "02"
  },
  {
    label: locale === "zh" ? "实验" : "Labs",
    value: "02"
  }
];
---

<section class="hero page-shell">
  <div class="hero-copy">
    <p class="eyebrow">
      <span></span>
      {locale === "zh" ? "双语专家档案 / 静态可部署" : "Bilingual expert dossier / static deploy"}
    </p>
    <h1>{localize(pack.profile.headline, locale)}</h1>
    <p class="summary">{localize(pack.profile.summary, locale)}</p>
    <div class="button-row">
      <a class="button primary" href={localePath(locale, "work")}>
        <Icon name="briefcase" size={16} />
        {l.work}
      </a>
      <a class="button" href={localePath(locale, "cv")}>
        <Icon name="file-text" size={16} />
        {l.viewCv}
      </a>
    </div>
    <dl class="proof-strip">
      {proof.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <aside class="identity-panel" aria-label={localize(pack.profile.name, locale)}>
    <div class="panel-grid" aria-hidden="true"></div>
    <div class="portrait-frame">
      <img src={avatarSrc} alt={localize(pack.profile.name, locale)} width="420" height="420" loading="eager" />
    </div>
    <div class="identity-meta">
      <div>
        <strong>{localize(pack.profile.name, locale)}</strong>
        <span>{localize(pack.profile.location, locale)}</span>
      </div>
      <p>{localize(pack.profile.availability.status, locale)}</p>
    </div>
    <div class="signal-list">
      {pack.roles.roles.slice(0, 3).map((role) => (
        <a href={localePath(locale, `for/${role.path}`)}>
          <span>{localize(role.title, locale)}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      ))}
    </div>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.76fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
    padding: 72px 0 58px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 16px;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 780;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent), transparent 86%);
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.25rem, 5.2vw, 5rem);
    font-weight: 760;
    line-height: 1;
    letter-spacing: 0;
  }

  .summary {
    max-width: 690px;
    margin: 22px 0 26px;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 38%);
    font-size: clamp(1.04rem, 1.35vw, 1.18rem);
  }

  .proof-strip {
    display: grid;
    max-width: 520px;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 30px 0 0;
  }

  .proof-strip div {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }

  dt {
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 720;
    text-transform: uppercase;
  }

  dd {
    margin: 4px 0 0;
    font-family: "JetBrains Mono", "IBM Plex Mono", monospace;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .identity-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 5%);
    border-radius: 10px;
    padding: 12px;
    background: color-mix(in srgb, var(--color-surface), transparent 4%);
    box-shadow: 0 30px 80px rgba(16, 20, 22, 0.11);
  }

  .panel-grid {
    position: absolute;
    inset: 0;
    opacity: 0.42;
    background:
      linear-gradient(color-mix(in srgb, var(--color-border), transparent 35%) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-border), transparent 35%) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, black, transparent 60%);
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 18%);
    background: var(--color-background);
  }

  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
  }

  .identity-meta {
    position: relative;
    display: grid;
    gap: 12px;
    padding: 16px 4px 8px;
  }

  .identity-meta strong,
  .identity-meta span {
    display: block;
  }

  .identity-meta span,
  .identity-meta p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .signal-list {
    position: relative;
    display: grid;
    gap: 6px;
    margin-top: 10px;
  }

  .signal-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-radius: 7px;
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 18%);
    padding: 10px 11px;
    background: color-mix(in srgb, var(--color-background), transparent 12%);
    color: var(--color-foreground);
    font-size: 0.92rem;
    font-weight: 680;
    transition: transform 180ms var(--ease-out), border-color 180ms var(--ease-out);
  }

  .signal-list a:hover {
    transform: translateX(2px);
    border-color: color-mix(in srgb, var(--color-accent), transparent 45%);
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 42px;
    }

    .identity-panel {
      max-width: 430px;
    }
  }

  @media (max-width: 560px) {
    .proof-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
