---
import Icon from "../common/Icon.astro";
import type { Locale } from "../../lib/config";
import { labels, localePath, localize, otherLocale, switchLocalePath } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
const altLocale = otherLocale(locale);
const altHref = switchLocalePath(Astro.url.pathname, altLocale);
const items = pack.navigation.items;
const primaryItems = items.filter((item) => item.placement === "primary").slice(0, 4);
const allMenuItems = items;
const configuredBrand = pack.navigation.brand.mark || "DossierKit";
const brandLabel =
  pack.navigation.brand.labelMode === "headline"
    ? localize(pack.profile.headline, locale)
    : pack.navigation.brand.labelMode === "none"
      ? ""
      : configuredBrand;

function navHref(path: string, external?: boolean) {
  if (external || /^https?:\/\//.test(path)) return path;
  return localePath(locale, path);
}

function isActive(path: string, external?: boolean) {
  if (external) return false;
  const href = navHref(path);
  if (href === localePath(locale)) return Astro.url.pathname === href || Astro.url.pathname === `${href}/`;
  return Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
}
---

<header class="site-header no-print" data-site-header data-visibility="shown">
  <div class="page-shell nav-card">
    <a class="brand" href={localePath(locale)} aria-label={localize(pack.profile.name, locale)}>
      {brandLabel && <span class="brand-word">{brandLabel}</span>}
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {primaryItems.map((item) => (
        <a class:list={{ active: isActive(item.path, item.external) }} href={navHref(item.path, item.external)}>
          {localize(item.label, locale)}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="language-pill" href={altHref} aria-label={l.switchLanguage} title={l.switchLanguage}>
        <Icon name="globe" size={22} />
        <span>{altLocale.toUpperCase()}</span>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </a>
      <details class="mobile-menu">
        <summary aria-label="Menu" title="Menu">
          <Icon name="menu" size={20} />
        </summary>
        <div class="mobile-menu-panel">
          {allMenuItems.map((item) => (
            <a href={navHref(item.path, item.external)}>
              {item.icon && <Icon name={item.icon} size={17} />}
              <span>{localize(item.label, locale)}</span>
            </a>
          ))}
          <a href={altHref}>
            <Icon name="globe" size={17} />
            <span>{l.switchLanguage}</span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  if (header) {
    let lastScrollY = Math.max(0, window.scrollY);
    let direction: "up" | "down" | null = null;
    let directionDistance = 0;
    let frameRequested = false;

    const showHeader = () => {
      header.dataset.visibility = "shown";
    };

    const updateHeader = () => {
      const currentScrollY = Math.max(0, window.scrollY);
      const delta = currentScrollY - lastScrollY;
      const nextDirection = delta > 0 ? "down" : delta < 0 ? "up" : direction;
      const menuOpen = Boolean(header.querySelector("details[open]"));

      if (nextDirection !== direction) {
        direction = nextDirection;
        directionDistance = 0;
      }

      directionDistance += Math.abs(delta);

      if (currentScrollY <= 72 || header.matches(":focus-within") || menuOpen) {
        showHeader();
      } else if (direction === "down" && directionDistance >= 24) {
        header.dataset.visibility = "hidden";
        directionDistance = 0;
      } else if (direction === "up" && directionDistance >= 12) {
        showHeader();
        directionDistance = 0;
      }

      lastScrollY = currentScrollY;
      frameRequested = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!frameRequested) {
          frameRequested = true;
          window.requestAnimationFrame(updateHeader);
        }
      },
      { passive: true }
    );

    header.addEventListener("focusin", showHeader);
    header.querySelector("details")?.addEventListener("toggle", showHeader);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding-top: 12px;
    transition:
      transform 320ms var(--ease-out),
      opacity 220ms ease;
    will-change: transform;
  }

  .site-header[data-visibility="hidden"] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 24px));
  }

  .site-header[data-visibility="shown"] {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-card {
    isolation: isolate;
    display: grid;
    min-height: 92px;
    grid-template-columns: minmax(190px, 1fr) auto minmax(190px, 1fr);
    align-items: center;
    gap: 20px;
    border: 1px solid transparent;
    border-radius: 30px;
    padding: 0 28px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(246, 255, 252, 0.72)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.44), rgba(120, 205, 225, 0.32), rgba(255, 255, 255, 0.74)) border-box;
    box-shadow: 0 18px 46px rgba(45, 58, 69, 0.09), 0 12px 34px rgba(85, 190, 162, 0.1);
    backdrop-filter: blur(18px) saturate(1.25);
  }

  .brand,
  .desktop-nav,
  .header-actions {
    position: relative;
    z-index: 1;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: 12px;
  }

  .brand-word {
    background: linear-gradient(100deg, #207f72 0%, #2fb98f 44%, #55bea2 72%, #2b9f98 100%);
    background-clip: text;
    color: transparent;
    font-family: "Pacifico", "Brush Script MT", cursive;
    font-size: clamp(1.65rem, 2vw, 2.08rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: clamp(24px, 5vw, 70px);
    color: var(--color-foreground);
    font-size: 1.08rem;
    font-weight: 780;
  }

  .desktop-nav a {
    position: relative;
    padding: 9px 0;
    transition: color 180ms ease, transform 180ms ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    border-radius: 999px;
    content: "";
    background: var(--gradient-primary);
    opacity: 0;
    transform: scaleX(0.35);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: #207f72;
    transform: translateY(-1px);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
  }

  .language-pill {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    gap: 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 10px 18px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.84), rgba(246, 255, 252, 0.66)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.34), rgba(120, 205, 225, 0.26)) border-box;
    color: #5a6375;
    font-size: 1.02rem;
    font-weight: 760;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .language-pill:hover {
    transform: translateY(-1px);
    color: #207f72;
    box-shadow: 0 12px 26px rgba(85, 190, 162, 0.18);
  }

  .mobile-menu {
    position: relative;
    display: none;
  }

  .mobile-menu summary {
    display: inline-grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.84), rgba(246, 255, 252, 0.66)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.34), rgba(120, 205, 225, 0.26)) border-box;
    color: #5a6375;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    display: grid;
    min-width: 220px;
    gap: 6px;
    border: 1px solid transparent;
    border-radius: 22px;
    padding: 10px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(246, 255, 252, 0.9)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.36), rgba(120, 205, 225, 0.28)) border-box;
    box-shadow: 0 24px 54px rgba(45, 58, 69, 0.16);
    backdrop-filter: blur(18px) saturate(1.2);
  }

  .mobile-menu-panel a {
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 14px;
    padding: 12px;
    color: #5a6375;
    font-weight: 760;
  }

  .mobile-menu-panel a:hover {
    background: linear-gradient(100deg, rgba(234, 249, 244, 0.82), rgba(235, 250, 255, 0.72));
    color: #207f72;
  }

  @media (max-width: 960px) {
    .nav-card {
      grid-template-columns: 1fr auto;
      min-height: 76px;
      border-radius: 24px;
      padding: 0 16px;
      backdrop-filter: none;
    }

    .desktop-nav {
      display: none;
    }

    .language-pill span,
    .language-pill > svg:last-child {
      display: none;
    }

    .language-pill {
      width: 48px;
      min-height: 48px;
      justify-content: center;
      padding: 0;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      top: 6px;
      padding-top: 6px;
    }

    .brand-word {
      font-size: 1.42rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
