---
import LanguageSwitch from "./LanguageSwitch.astro";
import type { Locale } from "../../lib/config";
import { localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const configuredBrand = pack.navigation.brand.mark || "DossierKit";
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const showNoteSearch = normalizedPath === localePath(locale) || normalizedPath === localePath(locale, "notes");
const brandLabel =
  pack.navigation.brand.labelMode === "headline"
    ? localize(pack.profile.headline, locale)
    : pack.navigation.brand.labelMode === "none"
      ? ""
      : configuredBrand;
---

<header class="site-header no-print" data-site-header data-visibility="shown">
  <div class:list={["page-shell", "nav-card", { "has-note-search": showNoteSearch }]}>
    <a class="brand" href={localePath(locale)} aria-label={brandLabel || localize(pack.profile.name, locale)}>
      {brandLabel && <span class="brand-word signature-wordmark">{brandLabel}</span>}
    </a>

    {showNoteSearch && (
      <div class="header-search" role="search">
        <input
          type="search"
          aria-label={locale === "zh" ? "搜索笔记" : "Search notes"}
          aria-keyshortcuts="Meta+K Control+K"
          placeholder="command + k"
          data-note-search
        />
      </div>
    )}

    <div class="header-actions">
      <LanguageSwitch locale={locale} pack={pack} />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  if (header) {
    let lastScrollY = Math.max(0, window.scrollY);
    let direction: "up" | "down" | null = null;
    let directionDistance = 0;
    let frameRequested = false;

    const showHeader = () => {
      header.dataset.visibility = "shown";
    };

    const updateHeader = () => {
      const currentScrollY = Math.max(0, window.scrollY);
      const delta = currentScrollY - lastScrollY;
      const nextDirection = delta > 0 ? "down" : delta < 0 ? "up" : direction;
      if (nextDirection !== direction) {
        direction = nextDirection;
        directionDistance = 0;
      }

      directionDistance += Math.abs(delta);

      if (currentScrollY <= 72 || header.matches(":focus-within")) {
        showHeader();
      } else if (direction === "down" && directionDistance >= 24) {
        header.dataset.visibility = "hidden";
        directionDistance = 0;
      } else if (direction === "up" && directionDistance >= 12) {
        showHeader();
        directionDistance = 0;
      }

      lastScrollY = currentScrollY;
      frameRequested = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!frameRequested) {
          frameRequested = true;
          window.requestAnimationFrame(updateHeader);
        }
      },
      { passive: true }
    );

    header.addEventListener("focusin", showHeader);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding-top: 12px;
    transition:
      transform 320ms var(--ease-out),
      opacity 220ms ease;
    will-change: transform;
  }

  .site-header[data-visibility="hidden"] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 24px));
  }

  .site-header[data-visibility="shown"] {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-card {
    isolation: isolate;
    display: grid;
    min-height: 78px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    border: 1px solid transparent;
    border-radius: 26px;
    padding: 0 20px 0 28px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(246, 255, 252, 0.72)) padding-box,
      linear-gradient(120deg, rgba(85, 190, 162, 0.44), rgba(120, 205, 225, 0.32), rgba(255, 255, 255, 0.74)) border-box;
    box-shadow: 0 18px 46px rgba(45, 58, 69, 0.09), 0 12px 34px rgba(85, 190, 162, 0.1);
    backdrop-filter: blur(18px) saturate(1.25);
  }

  .nav-card.has-note-search {
    grid-template-columns: minmax(0, 1fr) auto auto;
  }

  .brand,
  .header-actions {
    position: relative;
    z-index: 1;
  }

  .header-search {
    width: 180px;
  }

  .header-search input {
    width: 100%;
    min-height: 34px;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.28);
    color: var(--color-foreground);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.58;
    transition: background 180ms ease, border-color 180ms ease, opacity 180ms ease;
  }

  .header-search input:hover {
    background: rgba(255, 255, 255, 0.44);
    opacity: 0.78;
  }

  .header-search input:focus {
    border-color: color-mix(in srgb, var(--color-accent), transparent 52%);
    outline: 2px solid color-mix(in srgb, var(--color-accent), transparent 88%);
    background: rgba(255, 255, 255, 0.72);
    opacity: 1;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: 12px;
  }

  .brand-word {
    background: linear-gradient(100deg, #207f72 0%, #2fb98f 44%, #55bea2 72%, #2b9f98 100%);
    background-clip: text;
    color: transparent;
    font-size: clamp(1.35rem, 2.15vw, 1.9rem);
    line-height: 1.45;
    letter-spacing: 0;
    text-wrap: balance;
    padding: .08em .2em .16em 0;
    overflow-wrap: normal;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
  }

  @media (max-width: 960px) {
    .nav-card {
      grid-template-columns: 1fr auto;
      min-height: 76px;
      border-radius: 24px;
      padding: 0 16px;
      backdrop-filter: none;
    }

    .nav-card.has-note-search {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 8px;
    }

    .header-search {
      width: 140px;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      top: 6px;
      padding-top: 6px;
    }

    .brand-word {
      font-size: clamp(.95rem, 4.2vw, 1.15rem);
      line-height: 1.4;
      letter-spacing: 0;
    }

    .nav-card.has-note-search {
      gap: 6px;
      padding: 0 10px;
    }

    .header-search {
      width: 72px;
    }

    .header-search input {
      min-height: 32px;
      padding-inline: 8px;
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
