---
type Props = {
  tagline: string;
};
const { tagline } = Astro.props;
---

<footer class="cv-agent-signature-footer" aria-label="Personal motto">
  <p class="cv-agent-signature-line signature-wordmark">{tagline}</p>
</footer>

<style>
  /* Inspired by the Notes footer: a fine gradient rule and a quiet handwritten sign-off.
     Deliberately independent of site navigation, analytics and no-print behavior. */
  .cv-agent-signature-footer {
    position: relative;
    margin-top: 34px;
    padding: 20px 0 4px;
    text-align: center;
    break-inside: avoid;
  }

  .cv-agent-signature-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(85, 190, 162, 0.36) 30%,
      rgba(120, 205, 225, 0.3) 70%,
      transparent 100%
    );
  }

  .cv-agent-signature-line {
    display: inline-block;
    max-width: calc(100% - 16px);
    margin: 0;
    padding: .12em .28em .18em;
    color: #70808c;
    font-size: clamp(1.08rem, 2.3vw, 1.38rem);
    line-height: 1.6;
    text-wrap: balance;
  }

  @media (max-width: 700px) {
    .cv-agent-signature-footer {
      margin-top: 28px;
      padding-top: 16px;
    }
    .cv-agent-signature-line { font-size: 1.12rem; }
  }

  @media print {
    .cv-agent-signature-footer {
      margin-top: 28px;
      padding: 13px 0 0;
      break-inside: avoid;
    }
    .cv-agent-signature-line {
      font-size: 11pt;
      line-height: 1.42;
      color: #71808d;
    }
  }
</style>
