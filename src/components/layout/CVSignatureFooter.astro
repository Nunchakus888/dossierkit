---
import ViewCount from "../views/ViewCount.astro";
import { viewsEnabled } from "../../lib/view-counter/config";
import "../../styles/wordmarks.css";

type Props = {
  tagline: string;
  pageRef: string;
};
const { tagline, pageRef } = Astro.props;
---

<footer class="cv-agent-signature-footer" aria-label="Personal motto" data-cv-signature>
  <p class="cv-agent-signature-line signature-wordmark">{tagline}</p>
  {viewsEnabled && <div class="cv-agent-signature-stats no-print" data-pagefind-ignore>
    <ViewCount noteRef={pageRef} />
  </div>}
</footer>

<style>
  /* Inspired by the Notes footer: a fine gradient rule and a quiet handwritten sign-off.
     Deliberately independent of site navigation, analytics and no-print behavior. */
  .cv-agent-signature-footer {
    position: relative;
    margin-top: 34px;
    padding: 20px 0 4px;
    text-align: right;
    break-inside: avoid;
  }

  .cv-agent-signature-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(85, 190, 162, 0.36) 30%,
      rgba(120, 205, 225, 0.3) 70%,
      transparent 100%
    );
  }

  .cv-agent-signature-line {
    display: inline-block;
    max-width: 100%;
    margin: 0;
    padding: .1em 0 .16em;
    /* The CV starts with a left-aligned Pacifico name; end with its smaller twin. */
    color: #247f74;
    font-size: clamp(.95rem, 1.4vw, 1.05rem);
    font-weight: 400;
    line-height: 1.55;
    transform: none;
    text-wrap: balance;
  }

  .cv-agent-signature-stats {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 6px;
    min-height: 20px;
    --color-muted: #7b8794;
  }
  .cv-agent-signature-stats :global(.view-count) { font-size: 11px; opacity: .82; }

  @media (max-width: 700px) {
    .cv-agent-signature-footer {
      margin-top: 28px;
      padding-top: 16px;
    }
    .cv-agent-signature-line { font-size: .95rem; }
  }

  @media print {
    .cv-agent-signature-stats { display: none !important; }
    .cv-agent-signature-footer {
      margin-top: 28px;
      padding: 13px 0 0;
      break-inside: avoid;
    }
    .cv-agent-signature-line {
      font-size: 10pt;
      line-height: 1.42;
      color: #247f74;
    }
  }
</style>
