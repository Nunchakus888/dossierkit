---
import IconAction from "../common/IconAction.astro";
import ViewCount from "../views/ViewCount.astro";
import { viewsEnabled } from "../../lib/view-counter/config";
import type { Locale } from "../../lib/config";
import { localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
  pageRef?: string;
};

const { locale, pack, pageRef } = Astro.props;
const tagline = pack.navigation.footer?.tagline;
---

{
  (tagline || viewsEnabled) && (
    <footer class="site-footer no-print">
      <div class="page-shell footer-inner">
        {tagline && <p>{localize(tagline, locale)}</p>}
        {viewsEnabled && <div class="footer-meta" data-pagefind-ignore>
          <ViewCount noteRef={pageRef} showTotal={Boolean(pageRef)} locale={locale} />
          <IconAction icon="shield" size={15} class="counter-privacy" href={`/${locale}/privacy/`} label={locale === "zh" ? "统计与隐私" : "Statistics & privacy"} />
        </div>}
      </div>
    </footer>
  )
}

<style>
  .site-footer {
    border-top: 1px solid transparent;
    border-image: var(--gradient-border) 1;
    padding: 24px 0;
    background: rgba(255, 255, 255, 0.36);
  }

  .footer-inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: .5rem;
  }

  .footer-meta { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .4rem .9rem; }

  p {
    margin: 0;
    color: color-mix(in srgb, var(--color-muted), transparent 10%);
    font-size: 0.88rem;
    font-weight: 620;
  }
</style>
