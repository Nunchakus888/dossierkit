---
import type { Locale } from "../../lib/config";
import { labels, localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const l = labels[locale];
---

<footer class="site-footer no-print">
  <div class="page-shell footer-inner">
    <div>
      <strong>{localize(pack.profile.name, locale)}</strong>
      <p>{localize(pack.profile.headline, locale)}</p>
    </div>
    <div class="footer-links">
      <a href={localePath(locale, "cv")}>{l.cv}</a>
      <a href={localePath(locale, "contact")}>{l.contact}</a>
      <a href="/profile.json">profile.json</a>
      <a href="/llms.txt">llms.txt</a>
      <a href="/admin">admin</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 30px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  p {
    margin: 4px 0 0;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .footer-inner {
      display: block;
    }

    .footer-links {
      justify-content: flex-start;
      margin-top: 18px;
    }
  }
</style>
