---
import type { Locale } from "../../lib/config";
import { localePath, localize } from "../../lib/i18n";
import type { ProfilePack } from "../../lib/profile-loader";

type Props = {
  locale: Locale;
  pack: ProfilePack;
};

const { locale, pack } = Astro.props;
const footerItems = pack.navigation.items;

function navHref(path: string, external?: boolean) {
  if (external || /^https?:\/\//.test(path)) return path;
  return localePath(locale, path);
}
---

<footer class="site-footer no-print">
  <div class="page-shell footer-inner">
    <div>
      <strong>{localize(pack.profile.name, locale)}</strong>
      <p>{localize(pack.profile.headline, locale)}</p>
    </div>
    <div class="footer-links">
      {footerItems.map((item) => <a href={navHref(item.path, item.external)}>{localize(item.label, locale)}</a>)}
      <a href="/profile.json">profile.json</a>
      <a href="/llms.txt">llms.txt</a>
      <a href="/admin">admin</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-border), transparent 10%);
    padding: 34px 0;
    background: color-mix(in srgb, var(--color-surface), transparent 58%);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  p {
    margin: 4px 0 0;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .footer-links a {
    border-bottom: 1px solid transparent;
  }

  .footer-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .footer-inner {
      display: block;
    }

    .footer-links {
      justify-content: flex-start;
      margin-top: 18px;
    }
  }
</style>
