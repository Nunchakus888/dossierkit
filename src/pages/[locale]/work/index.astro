---
import CaseCard from "../../../components/dossier/CaseCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../../lib/config";
import { getCollection } from "../../../lib/content-query";
import { labels } from "../../../lib/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const entries = getCollection(locale, "cases");
const l = labels[locale];
---

<BaseLayout locale={locale} title={l.work}>
  <section class="page-shell list-page">
    <header>
      <p>{l.work}</p>
      <h1>{l.featuredCases}</h1>
    </header>
    <div class="card-grid">
      {entries.map((entry) => <CaseCard locale={locale} entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .list-page {
    padding: 46px 0 72px;
  }

  header p {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-weight: 750;
  }

  h1 {
    margin: 0 0 28px;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 760px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
