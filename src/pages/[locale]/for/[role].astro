---
import CaseCard from "../../../components/dossier/CaseCard.astro";
import LabCard from "../../../components/dossier/LabCard.astro";
import Icon from "../../../components/common/Icon.astro";
import ContactPanel from "../../../components/dossier/ContactPanel.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../../lib/config";
import { getContent } from "../../../lib/content-query";
import { labels, localePath, localize } from "../../../lib/i18n";
import { loadProfilePack } from "../../../lib/profile-loader";

export function getStaticPaths() {
  const packForPaths = loadProfilePack();
  return locales.flatMap((locale) =>
    packForPaths.roles.roles.map((role) => ({
      params: { locale, role: role.path },
      props: { role }
    }))
  );
}

const locale = Astro.params.locale as Locale;
const pack = loadProfilePack();
const { role } = Astro.props as { role: (typeof pack.roles.roles)[number] };
const l = labels[locale];
const cases = role.relatedCases.map((slug) => getContent(locale, "cases", slug)).filter(Boolean);
const labs = role.relatedLabs.map((slug) => getContent(locale, "lab", slug)).filter(Boolean);
const writing = role.relatedWriting.map((slug) => getContent(locale, "writing", slug)).filter(Boolean);
const assessment = role.positioningAssessment;
---

<BaseLayout locale={locale} title={localize(role.title, locale)} description={localize(role.summary, locale)}>
  <section class="page-shell role-page">
    <header>
      <p>{l.roles}</p>
      <h1>{localize(role.headline, locale)}</h1>
      <div class="summary">{localize(role.summary, locale)}</div>
      <ul class="tag-list">
        {role.focusAreas.map((area) => <li class="tag">{area}</li>)}
      </ul>
    </header>
  </section>

  {assessment && (
    <section class="section-band assessment-band">
      <div class="page-shell assessment-grid">
        <div class="assessment-copy">
          <div class="score-pill">
            <Icon name="target" size={17} />
            <span>{assessment.fitScore}</span>
          </div>
          <h2>{locale === "zh" ? "定位匹配" : "Positioning Fit"}</h2>
          <p>{localize(assessment.conclusion, locale)}</p>
          <ul class="tag-list">
            {assessment.targetPositioning.map((item) => <li class="tag">{localize(item, locale)}</li>)}
          </ul>
          {writing.length > 0 && (
            <div class="button-row">
              {writing.map((entry) => entry && (
                <a class="button" href={localePath(locale, `writing/${entry.slug}`)}>
                  <Icon name="file-text" size={16} />
                  <span>{locale === "zh" ? "能力地图" : "Capability map"}</span>
                </a>
              ))}
            </div>
          )}
        </div>

        <div class="signal-panel">
          <div class="mini-heading">
            <Icon name="sparkle" size={18} />
            <h3>{locale === "zh" ? "关键证据" : "Signals"}</h3>
          </div>
          <ul class="signal-list">
            {assessment.evidence.slice(0, 6).map((item) => <li>{localize(item, locale)}</li>)}
          </ul>
        </div>
      </div>
    </section>
  )}

  {assessment && assessment.pendingEvidence.length > 0 && (
    <section class="section-band pending-band">
      <div class="page-shell">
        <div class="section-heading">
          <div>
            <h2>{locale === "zh" ? "可深入沟通" : "Discussion Areas"}</h2>
            <p>{locale === "zh" ? "围绕规模口径、治理边界、团队机制和业务结果展开。" : "Areas for deeper discussion across scale, governance, team mechanisms, and business outcomes."}</p>
          </div>
        </div>
        <div class="pending-grid">
          {assessment.pendingEvidence.map((group) => (
            <section class="pending-item">
              <div class="pending-icon" aria-hidden="true">
                <Icon name="terminal" size={18} />
              </div>
              <div>
                <h3>{localize(group.title, locale)}</h3>
                {group.summary && <p>{localize(group.summary, locale)}</p>}
                <ul>
                  {group.items.map((item) => <li>{localize(item, locale)}</li>)}
                </ul>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-band">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <h2>{l.relatedWork}</h2>
          <p>{locale === "zh" ? "与该方向最相关的生产案例。" : "Production case studies most relevant to this direction."}</p>
        </div>
      </div>
      <div class="card-grid">
        {cases.map((entry) => entry && <CaseCard locale={locale} entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <h2>{l.relatedLab}</h2>
          <p>{locale === "zh" ? "与该方向能力匹配的实验记录。" : "Lab notes that match this capability profile."}</p>
        </div>
      </div>
      <div class="card-grid">
        {labs.map((entry) => entry && <LabCard locale={locale} entry={entry} />)}
      </div>
    </div>
  </section>

  <ContactPanel locale={locale} pack={pack} />
</BaseLayout>

<style>
  .role-page {
    padding: 48px 0 20px;
  }

  header {
    max-width: 1060px;
  }

  header p {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-weight: 750;
  }

  h1 {
    margin: 0;
    max-width: 1040px;
    font-size: 4.2rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .summary {
    max-width: 760px;
    margin-top: 18px;
    color: var(--color-muted);
    font-size: 1.15rem;
  }

  .tag-list {
    margin-top: 22px;
  }

  .assessment-band {
    padding-top: 48px;
    background:
      radial-gradient(circle at 16% 18%, color-mix(in srgb, var(--color-accent-soft), transparent 12%), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.5), transparent);
  }

  .assessment-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(320px, 1fr);
    gap: 18px;
    align-items: stretch;
  }

  .assessment-copy,
  .signal-panel,
  .pending-item {
    border: 1px solid color-mix(in srgb, var(--color-border), transparent 10%);
    border-radius: var(--card-radius);
    background: color-mix(in srgb, var(--color-surface), transparent 4%);
    box-shadow: 0 18px 45px rgba(38, 47, 58, 0.055);
  }

  .assessment-copy {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    justify-content: center;
    padding: 26px;
  }

  .score-pill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 42%);
    border-radius: 999px;
    padding: 7px 12px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: 780;
    line-height: 1;
  }

  .assessment-copy h2 {
    margin: 18px 0 12px;
    font-size: 2.9rem;
    line-height: 1;
  }

  .assessment-copy p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 28%);
    font-size: 1.05rem;
  }

  .assessment-copy .button-row {
    margin-top: 24px;
  }

  .signal-panel {
    padding: 24px;
  }

  .mini-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent);
  }

  .mini-heading h3 {
    margin: 0;
    color: var(--color-foreground);
    font-size: 1.12rem;
  }

  .signal-list {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 20px 0 0;
    list-style: none;
  }

  .signal-list li {
    position: relative;
    padding-left: 24px;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 22%);
  }

  .signal-list li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-soft);
    content: "";
  }

  .pending-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .pending-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 18px;
  }

  .pending-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 14px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .pending-item h3 {
    margin: 3px 0 10px;
    font-size: 1.03rem;
    line-height: 1.2;
  }

  .pending-item p {
    margin: 0 0 10px;
    color: var(--color-muted);
  }

  .pending-item ul {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .pending-item li {
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .pending-item li::before {
    color: var(--color-accent);
    content: "+ ";
    font-weight: 800;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 760px) {
    h1 {
      font-size: 2.5rem;
    }

    .assessment-copy h2 {
      font-size: 2.25rem;
    }

    .assessment-grid,
    .pending-grid {
      grid-template-columns: 1fr;
    }

    .assessment-copy {
      min-height: auto;
      padding: 22px;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
