---
import CaseCard from "../../../components/dossier/CaseCard.astro";
import LabCard from "../../../components/dossier/LabCard.astro";
import Icon from "../../../components/common/Icon.astro";
import ContactPanel from "../../../components/dossier/ContactPanel.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../../lib/config";
import { getContent } from "../../../lib/content-query";
import { labels, localePath, localize } from "../../../lib/i18n";
import { loadProfilePack } from "../../../lib/profile-loader";

export function getStaticPaths() {
  const packForPaths = loadProfilePack();
  return locales.flatMap((locale) =>
    packForPaths.roles.roles.map((role) => ({
      params: { locale, role: role.path },
      props: { role }
    }))
  );
}

const locale = Astro.params.locale as Locale;
const pack = loadProfilePack();
const { role } = Astro.props as { role: (typeof pack.roles.roles)[number] };
const l = labels[locale];
const cases = role.relatedCases.map((slug) => getContent(locale, "cases", slug)).filter(Boolean);
const labs = role.relatedLabs.map((slug) => getContent(locale, "lab", slug)).filter(Boolean);
const platformProfile = role.platformProfile;
const writingEntry = platformProfile?.sourceWriting
  ? getContent(locale, "writing", platformProfile.sourceWriting)
  : null;
---

<BaseLayout locale={locale} title={localize(role.title, locale)} description={localize(role.summary, locale)}>
  <section class="page-shell role-hero">
    <p>{locale === "zh" ? "平台方向" : "Platform Focus"}</p>
    <h1>{localize(role.headline, locale)}</h1>
    <div class="summary">{localize(role.summary, locale)}</div>
    <ul class="tag-list">
      {role.focusAreas.map((area) => <li class="tag">{area}</li>)}
    </ul>
  </section>

  {platformProfile && (
    <section class="section-band ownership-band">
      <div class="page-shell ownership-grid">
        <div class="ownership-copy">
          <span class="ownership-badge">
            <Icon name="target" size={16} />
            {platformProfile.badge}
          </span>
          <h2>{localize(platformProfile.title, locale)}</h2>
          <p>{localize(platformProfile.summary, locale)}</p>
          {writingEntry && (
            <a class="button" href={localePath(locale, `writing/${writingEntry.slug}`)}>
              <Icon name="file-text" size={16} />
              <span>{locale === "zh" ? "平台能力地图" : "Platform capability map"}</span>
            </a>
          )}
        </div>

        <ol class="capability-ledger">
          {platformProfile.capabilities.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{localize(item, locale)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {platformProfile && platformProfile.dimensions.length > 0 && (
    <section class="section-band dimension-band">
      <div class="page-shell">
        <div class="section-heading">
          <div>
            <h2>{locale === "zh" ? "核心工作面" : "Core Operating Areas"}</h2>
            <p>{locale === "zh" ? "以生产结果串联架构决策、平台能力和团队交付。" : "Connecting architecture decisions, platform capabilities, and team delivery through production outcomes."}</p>
          </div>
        </div>
        <div class="dimension-grid">
          {platformProfile.dimensions.map((dimension, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{localize(dimension.title, locale)}</h3>
              <p>{localize(dimension.summary, locale)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-band">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <h2>{locale === "zh" ? "代表性交付" : "Selected Delivery"}</h2>
          <p>{locale === "zh" ? "覆盖 AI Agent 平台、模型服务与大规模平台工程。" : "AI Agent platforms, model serving, and large-scale platform engineering."}</p>
        </div>
      </div>
      <div class="card-grid">
        {cases.map((entry) => entry && <CaseCard locale={locale} entry={entry} />)}
      </div>
    </div>
  </section>

  {labs.length > 0 && (
    <section class="section-band lab-band">
      <div class="page-shell">
        <div class="section-heading">
          <div>
            <h2>{locale === "zh" ? "评测实践" : "Evaluation Practice"}</h2>
            <p>{locale === "zh" ? "将生产 trace 转化为回放评测与发布门禁。" : "Turning production traces into replay evaluation and release gates."}</p>
          </div>
        </div>
        <div class="lab-grid">
          {labs.map((entry) => entry && <LabCard locale={locale} entry={entry} />)}
        </div>
      </div>
    </section>
  )}

  <ContactPanel locale={locale} pack={pack} />
</BaseLayout>

<style>
  .role-hero {
    padding: 52px 0 44px;
  }

  .role-hero > p {
    margin: 0 0 10px;
    color: var(--color-accent);
    font-weight: 760;
  }

  h1 {
    max-width: 1040px;
    margin: 0;
    font-size: 4.2rem;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .summary {
    max-width: 800px;
    margin-top: 20px;
    color: var(--color-muted);
    font-size: 1.14rem;
    line-height: 1.72;
  }

  .role-hero .tag-list {
    margin-top: 24px;
  }

  .ownership-band {
    background:
      linear-gradient(118deg, rgba(234, 249, 244, 0.62), rgba(255, 255, 255, 0.5) 48%, rgba(231, 249, 255, 0.48)),
      repeating-linear-gradient(90deg, rgba(85, 190, 162, 0.065) 0 1px, transparent 1px 88px);
  }

  .ownership-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.18fr);
    gap: 64px;
    align-items: start;
  }

  .ownership-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #207f72;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .ownership-copy h2 {
    margin: 18px 0 14px;
    font-size: 2.65rem;
    line-height: 1.05;
  }

  .ownership-copy p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 32%);
    line-height: 1.74;
  }

  .ownership-copy .button {
    width: fit-content;
    margin-top: 26px;
  }

  .capability-ledger {
    padding: 0;
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border), var(--color-accent) 12%);
    list-style: none;
  }

  .capability-ledger li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border), var(--color-accent) 12%);
    padding: 16px 0;
  }

  .capability-ledger span {
    color: var(--color-accent);
    font-family: "JetBrains Mono", "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    font-weight: 760;
  }

  .capability-ledger p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground), var(--color-muted) 20%);
    line-height: 1.65;
  }

  .dimension-band {
    background: rgba(255, 255, 255, 0.38);
  }

  .dimension-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .dimension-grid article {
    min-height: 228px;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 20px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(247, 255, 253, 0.74)) padding-box,
      var(--gradient-border) border-box;
    box-shadow: var(--shadow-soft);
  }

  .dimension-grid article > span {
    color: var(--color-accent);
    font-family: "JetBrains Mono", "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    font-weight: 780;
  }

  .dimension-grid h3 {
    margin: 36px 0 12px;
    font-size: 1.18rem;
    line-height: 1.2;
  }

  .dimension-grid p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .lab-band {
    background: rgba(234, 249, 244, 0.28);
  }

  .lab-grid {
    max-width: 560px;
  }

  @media (max-width: 980px) {
    .ownership-grid,
    .dimension-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ownership-copy {
      grid-column: 1 / -1;
      max-width: 720px;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .role-hero {
      padding: 40px 0 32px;
    }

    h1 {
      font-size: 2.65rem;
    }

    .ownership-grid,
    .dimension-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ownership-copy h2 {
      font-size: 2.1rem;
    }

    .dimension-grid article {
      min-height: auto;
    }

    .dimension-grid h3 {
      margin-top: 20px;
    }
  }
</style>
