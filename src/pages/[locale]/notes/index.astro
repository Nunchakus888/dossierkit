---
import NoteCard from "../../../components/dossier/NoteCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../../lib/config";
import { getCollection } from "../../../lib/content-query";
import { labels } from "../../../lib/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const entries = getCollection(locale, "notes");
const l = labels[locale];
---

<BaseLayout locale={locale} title={l.latestNotes} description={locale === "zh" ? "围绕企业 Agent 平台架构沉淀的研究、学习与工程笔记。" : "Research, learning, and engineering notes on enterprise Agent platform architecture."}>
  <section class="page-shell notes-page">
    <header>
      <p>{l.notes}</p>
      <h1>{l.latestNotes}</h1>
      <div class="intro">{locale === "zh" ? "将持续研究整理为可检索、可复核、可长期引用的知识。" : "Continuous research organized as searchable, reviewable, and durable knowledge."}</div>
    </header>

    {entries.length > 0 && (
      <label class="note-search no-print">
        <span>{locale === "zh" ? "搜索笔记" : "Search notes"}</span>
        <input type="search" placeholder={locale === "zh" ? "标题、摘要或主题" : "Title, summary, or topic"} data-note-search />
      </label>
    )}

    <div class="note-list" data-note-list>
      {entries.map((entry) => <NoteCard locale={locale} entry={entry} />)}
    </div>

    <p class="empty-state" data-empty-state hidden={entries.length > 0}>
      {entries.length === 0
        ? locale === "zh" ? "该语言暂未发布笔记。" : "No notes have been published in this language yet."
        : locale === "zh" ? "没有匹配的笔记。" : "No matching notes."}
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-note-search]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-note-card]"));
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matches = !query || (card.dataset.search || "").includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .notes-page {
    padding: 46px 0 76px;
  }

  header {
    max-width: 780px;
    margin-bottom: 30px;
  }

  header p {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-weight: 750;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    line-height: 1;
  }

  .intro {
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .note-search {
    display: grid;
    max-width: 560px;
    gap: 8px;
    margin-bottom: 24px;
    color: var(--color-muted);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .note-search input {
    min-height: 48px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--color-foreground);
    font: inherit;
    font-weight: 500;
  }

  .note-search input:focus {
    border-color: var(--color-accent);
    outline: 3px solid color-mix(in srgb, var(--color-accent), transparent 82%);
  }

  .note-list {
    display: grid;
    gap: 14px;
  }

  .empty-state {
    border: 1px dashed var(--color-border);
    border-radius: var(--card-radius);
    padding: 28px;
    color: var(--color-muted);
    text-align: center;
  }
</style>
