---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../../lib/config";
import { labels, localePath } from "../../../lib/i18n";
import { decorateNoteHtml } from "../../../lib/note-render";
import { readContentCollection, type ContentEntry } from "../../../lib/profile-loader";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    readContentCollection(locale, "notes").map((entry) => ({
      params: { locale, slug: entry.slug },
      props: { entry }
    }))
  );
}

const locale = Astro.params.locale as Locale;
const { entry } = Astro.props as { entry: ContentEntry };
const l = labels[locale];
const rendered = decorateNoteHtml(entry.html);
const topics = entry.data.topics.length > 0 ? entry.data.topics : entry.data.tags;
const hanCharacters = (entry.body.match(/[\u3400-\u9fff]/g) || []).length;
const latinWords = (entry.body.match(/[A-Za-z0-9][A-Za-z0-9+'-]*/g) || []).length;
const readingMinutes = Math.max(1, Math.ceil((hanCharacters + latinWords * 2) / 500));
const canonicalPath = localePath(locale, `notes/${entry.slug}`);
const kindLabel = {
  research: locale === "zh" ? "研究" : "Research",
  learning: locale === "zh" ? "学习" : "Learning",
  engineering: locale === "zh" ? "工程" : "Engineering"
}[entry.data.kind || "research"];
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.summary}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updatedAt || entry.data.lastReviewedAt}
>
  <article class="page-shell note-page">
    <a class="back-link no-print" href={localePath(locale, "notes")}>{l.backToList}</a>

    <header class="note-header">
      <div class="note-kicker">
        <span>{kindLabel}</span>
        {entry.data.date && <time datetime={entry.data.date}>{entry.data.date}</time>}
        <span>{readingMinutes} {locale === "zh" ? "分钟阅读" : "min read"}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      {topics.length > 0 && (
        <ul class="tag-list" aria-label={locale === "zh" ? "主题" : "Topics"}>
          {topics.map((topic) => <li class="tag">{topic}</li>)}
        </ul>
      )}
      <div class="note-actions no-print">
        <button type="button" data-copy-link>{locale === "zh" ? "复制链接" : "Copy link"}</button>
      </div>
    </header>

    <div class:list={["note-layout", { "without-toc": rendered.headings.length === 0 }]}>
      {rendered.headings.length > 0 && (
        <aside class="note-toc no-print" aria-label={locale === "zh" ? "目录" : "Table of contents"}>
          <strong>{locale === "zh" ? "目录" : "Contents"}</strong>
          <nav>
            {rendered.headings.map((heading) => (
              <a class:list={[`depth-${heading.depth}`]} href={`#${heading.id}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
      <div class="prose note-prose" set:html={rendered.html} />
    </div>
  </article>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  copyButton?.addEventListener("click", async () => {
    const original = copyButton.textContent || "";
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyButton.textContent = document.documentElement.lang === "zh" ? "已复制" : "Copied";
      window.setTimeout(() => { copyButton.textContent = original; }, 1600);
    } catch {
      copyButton.textContent = window.location.href;
    }
  });
</script>

<style>
  .note-page {
    padding: 46px 0 82px;
  }

  .back-link {
    color: var(--color-accent);
    font-weight: 750;
  }

  .note-header {
    max-width: 900px;
    margin: 20px 0 44px;
  }

  .note-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .note-kicker > * + *::before {
    margin-right: 10px;
    color: var(--color-border);
    content: "•";
  }

  h1 {
    max-width: 980px;
    margin: 13px 0 0;
    font-size: clamp(2.2rem, 5vw, 4.7rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .summary {
    max-width: 820px;
    margin: 20px 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
  }

  .note-actions {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .note-actions button,
  .note-actions a {
    min-height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 13px;
    background: rgba(255, 255, 255, 0.76);
    color: var(--color-foreground);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .note-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 800px);
    align-items: start;
    gap: clamp(30px, 5vw, 72px);
  }

  .note-layout.without-toc {
    grid-template-columns: minmax(0, 800px);
  }

  .note-toc {
    position: sticky;
    top: 132px;
    max-height: calc(100vh - 160px);
    overflow: auto;
    border-left: 1px solid var(--color-border);
    padding-left: 16px;
  }

  .note-toc strong {
    display: block;
    margin-bottom: 10px;
    font-size: 0.84rem;
  }

  .note-toc nav {
    display: grid;
    gap: 8px;
  }

  .note-toc a {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .note-toc a:hover {
    color: var(--color-accent);
  }

  .note-toc .depth-3 {
    padding-left: 12px;
  }

  .note-toc .depth-4 {
    padding-left: 24px;
  }

  .note-prose {
    min-width: 0;
    max-width: 800px;
  }

  @media (max-width: 900px) {
    .note-layout {
      grid-template-columns: 1fr;
    }

    .note-toc {
      position: static;
      max-height: none;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.64);
    }

    .note-toc nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .note-toc nav {
      grid-template-columns: 1fr;
    }
  }
</style>
